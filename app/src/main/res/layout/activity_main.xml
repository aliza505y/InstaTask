<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: Unknown"
        android:textSize="18sp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnAccessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Accessibility Service"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnStartBot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Bot"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnStopBot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stop Bot"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Statistics:\n- Profiles Scanned: 0\n- Matches Found: 0\n- Likes Distributed: 0\n- Stories Reacted: 0"
        android:textSize="16sp"
        android:lineSpacingExtra="4dp" />

</LinearLayout>